+++ b/app/src/perf/kotlin/com/example/app/perf/TraceEventListener.kt
@@ -0,0 +1,119 @@
+// Generated by hb-performance (perf.py instrumentar); `instrumentar --actualizar` overwrites this file.
+// hb-performance fingerprint: 08dcb99365aa35b8
+package com.example.app.perf
+
+import android.util.Log
+import okhttp3.Call
+import okhttp3.Connection
+import okhttp3.EventListener
+import okhttp3.Protocol
+import okhttp3.Request
+import java.io.IOException
+import java.net.InetSocketAddress
+import java.net.Proxy
+import java.util.Collections
+import java.util.concurrent.ConcurrentHashMap
+import java.util.concurrent.atomic.AtomicInteger
+
+// HTTP <endpoint>: the whole call, body read included (callStart to callEnd or callFailed).
+// QUEUE <endpoint>: from callStart until the call reaches a connection: the wait in the dispatcher queue
+// (maxRequestsPerHost) plus the application interceptors.
+// CONN <endpoint>: a new connection (DNS, TCP and TLS), from dnsStart or connectStart to connectEnd.
+// TTFB <endpoint>: from the end of the request headers to the first response byte (server plus network).
+// Async sections, so concurrent calls show up overlapped. Needs OkHttp 4+. Register it with
+// builder.eventListenerFactory(TraceEventListener.FACTORY); OkHttp takes a single factory.
+// Once per service and process, one logcat line (tag hb-perf) with the method, the short name of the sections and the
+// real URL without its query (request.url): perf.py capturar reads it outside the trace (adb logcat -d -s hb-perf) and
+// the reports show the full route next to the short name. The section names do not change.
+class TraceEventListener(
+    call: Call,
+    private val tracer: SectionTracer = PlatformSectionTracer,
+    private val log: (String) -> Unit = { Log.i(LOG_TAG, it) },
+) : EventListener() {
+    private val endpoint = HttpSectionName.endpoint(call.request())
+    private val http = Section("HTTP")
+    private val queue = Section("QUEUE")
+    private val conn = Section("CONN")
+    private val ttfb = Section("TTFB")
+
+    override fun callStart(call: Call) {
+        logService(call.request())
+        http.begin()
+        queue.begin()
+    }
+
+    private fun logService(request: Request) {
+        // Once per service: the short name without the query hash, so other pages or filters do not log again.
+        if (LOGGED.add(endpoint.removeSuffix(HttpSectionName.queryTag(request)))) {
+            val url = request.url.newBuilder().query(null).fragment(null).build()
+            log("servicio\t${request.method}\t$endpoint\t$url")
+        }
+    }
+
+    override fun dnsStart(call: Call, domainName: String) {
+        queue.end()
+        conn.beginOnce()
+    }
+
+    override fun connectStart(call: Call, inetSocketAddress: InetSocketAddress, proxy: Proxy) {
+        queue.end()
+        conn.beginOnce() // a failed route retries inside the same CONN
+    }
+
+    override fun connectEnd(call: Call, inetSocketAddress: InetSocketAddress, proxy: Proxy, protocol: Protocol?) =
+        conn.end()
+
+    override fun connectionAcquired(call: Call, connection: Connection) {
+        queue.end() // a pooled connection: no DNS or connect
+        conn.end()
+    }
+
+    override fun requestHeadersEnd(call: Call, request: Request) {
+        queue.end()
+        ttfb.end() // a redirect or a retry closes the previous TTFB
+        ttfb.begin()
+    }
+
+    override fun responseHeadersStart(call: Call) = ttfb.end()
+
+    override fun callEnd(call: Call) = finish()
+
+    override fun callFailed(call: Call, ioe: IOException) = finish()
+
+    private fun finish() {
+        queue.end()
+        conn.end()
+        ttfb.end()
+        http.end()
+    }
+
+    private inner class Section(prefix: String) {
+        private val name = "$prefix $endpoint"
+        private var cookie = 0
+
+        fun beginOnce() {
+            if (cookie == 0) begin()
+        }
+
+        fun begin() {
+            cookie = COOKIES.incrementAndGet()
+            tracer.beginAsyncSection(name, cookie)
+        }
+
+        fun end() {
+            if (cookie != 0) tracer.endAsyncSection(name, cookie)
+            cookie = 0
+        }
+    }
+
+    companion object {
+        const val LOG_TAG = "hb-perf"
+        private val COOKIES = AtomicInteger()
+        // Collections.newSetFromMap and not ConcurrentHashMap.newKeySet(), which needs API 24 (lint flags it in debug).
+        private val LOGGED: MutableSet<String> = Collections.newSetFromMap(ConcurrentHashMap<String, Boolean>())
+
+        val FACTORY: EventListener.Factory = object : EventListener.Factory {
+            override fun create(call: Call): EventListener = TraceEventListener(call)
+        }
+    }
+}
