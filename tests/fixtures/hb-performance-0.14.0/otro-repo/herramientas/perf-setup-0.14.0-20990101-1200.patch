@@ -0,0 +1,35 @@
+// Generated by hb-performance (perf.py instrumentar); `instrumentar --actualizar` overwrites this file.
+// hb-performance fingerprint: 2753a70f5058c64b
+package com.example.app.perf
+
+import okhttp3.EventListener
+import okhttp3.OkHttpClient
+
+// Hooks the main code calls unconditionally. Empty in release: PerfInstaller (debug and profiling only) points them
+// at the tracing classes at startup, so release never links them. Keep the calls cheap: pass the destination as is.
+object PerfHooks {
+    // Navigation without an activity change: call it with the route template or the destination key.
+    var navigation: (Any) -> Unit = {}
+
+    // Content visible: call it once when what the user waits for is on screen, e.g. PerfHooks.mark("detalle").
+    var mark: (String) -> Unit = {}
+
+    // Call it on every OkHttpClient.Builder before build(): PerfHooks.okHttp(builder).
+    var okHttp: (OkHttpClient.Builder) -> Unit = {}
+
+    // The same call in one line from Java: PerfHooks.applyOkHttp(builder).
+    @JvmStatic
+    fun applyOkHttp(builder: OkHttpClient.Builder): OkHttpClient.Builder = builder.also(okHttp)
+
+    // One line per OkHttpClient.Builder when the factories come from a DI multibinding, from Kotlin or Java:
+    // PerfHooks.applyEventListener(builder, factories). Applies the first factory; an empty set (release) changes
+    // nothing. OkHttp takes a single factory: if the builder already has one, combine them.
+    @JvmStatic
+    fun applyEventListener(
+        builder: OkHttpClient.Builder,
+        factories: Set<EventListener.Factory>
+    ): OkHttpClient.Builder {
+        factories.firstOrNull()?.let { builder.eventListenerFactory(it) }
+        return builder
+    }
+}
