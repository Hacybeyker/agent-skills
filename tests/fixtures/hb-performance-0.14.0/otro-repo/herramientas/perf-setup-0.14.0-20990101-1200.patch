+package com.example.app.perf
+
+import okhttp3.Call
+import okhttp3.EventListener
+import okhttp3.OkHttpClient
+import org.junit.After
+import org.junit.Assert.assertNotSame
+import org.junit.Assert.assertSame
+import org.junit.Test
+
+class PerfHooksTest {
+    private val factory = object : EventListener.Factory {
+        override fun create(call: Call): EventListener = EventListener.NONE
+    }
+
+    @After
+    fun restoreHook() {
+        PerfHooks.okHttp = {}
+    }
+
+    @Test
+    fun applyEventListenerUsesTheFirstFactoryOfTheSet() {
+        val client = PerfHooks.applyEventListener(OkHttpClient.Builder(), setOf(factory)).build()
+        assertSame(factory, client.eventListenerFactory)
+    }
+
+    @Test
+    fun applyEventListenerLeavesTheBuilderAsIsWithAnEmptySet() {
+        val client = PerfHooks.applyEventListener(OkHttpClient.Builder(), emptySet()).build()
+        assertNotSame(factory, client.eventListenerFactory)
+    }
+
+    @Test
+    fun applyOkHttpRunsTheHookAndReturnsTheSameBuilder() {
+        PerfHooks.okHttp = { it.eventListenerFactory(factory) }
+        val builder = OkHttpClient.Builder()
+        assertSame(builder, PerfHooks.applyOkHttp(builder))
+        assertSame(factory, builder.build().eventListenerFactory)
+    }
+}
