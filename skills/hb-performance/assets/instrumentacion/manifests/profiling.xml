<?xml version="1.0" encoding="utf-8"?>
<!-- Generated by hb-performance: profileable so Perfetto and simpleperf can read the app, plus PerfInstaller. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <profileable android:shell="true" />

        <provider
            android:name="{{PAQUETE}}.PerfInstaller"
            android:authorities="${applicationId}.perf-installer"
            android:exported="false" />
    </application>

</manifest>
